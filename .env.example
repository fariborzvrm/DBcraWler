# Copy to .env and fill in your key.
# Never commit .env.
OPENROUTER_API_KEY=

# Chat model for SQL generation (ADR-004)
CHAT_MODEL=openrouter/free

# Embedding model for schema filtering (ADR-005)
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Database
DB_URL=postgresql+psycopg://app_readonly:readonly_password@localhost:5433/dbcrawler
DB_ADMIN_URL=postgresql+psycopg://app_owner:owner_password@localhost:5433/dbcrawler

# Schema filtering
SIMILARITY_THRESHOLD=0.3
SAMPLE_VALUES_PER_COLUMN=5
